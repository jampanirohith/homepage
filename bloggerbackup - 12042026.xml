    <b:skin><![CDATA[
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: "Segoe UI", Arial, sans-serif; color: #333; line-height: 1.6; background-color: #ffffff; }
    .container { display: flex; min-height: 100vh; }
    
    .sidebar { width: 280px; background-color: #f8f9fa; padding: 30px 20px; border-right: 1px solid #e0e0e0; position: fixed; height: 100vh; overflow-y: auto; z-index: 10; }
    .profile-photo { text-align: center; margin-bottom: 20px; }
    .profile-photo img { width: 150px; height: 200px; border-radius: 0%; object-fit: cover; background-color: #e0e0e0; border: 2px solid #ccc; }
    .sidebar h1 { font-size: 1.4em; text-align: center; margin-bottom: 5px; font-weight: normal; }
    .sidebar p { text-align: center; font-size: 0.9em; color: #666; margin-bottom: 30px; }
    nav ul { list-style: none; }
    nav ul li { margin-bottom: 5px; }
    nav ul li a { text-decoration: none; color: #444; display: block; padding: 10px 15px; border-radius: 4px; transition: background 0.2s, font-weight 0.2s; cursor: pointer; }
    nav ul li a:hover { background-color: #eaeaea; }
    nav ul li a.active { background-color: #e2e2e2; font-weight: bold; color: #000; }
    
    .content { margin-left: 280px; padding: 50px; max-width: 900px; width: 100%; }
    .section { display: none; }
    .section.active { display: block; animation: fadeIn 0.4s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    h2 { border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 25px; font-weight: normal; color: #222; }
    h2.sh { border-bottom: none; margin-bottom: 10px; margin-top: 30px; font-size: 1.2em; }
    p { margin-bottom: 15px; }
    .item { margin-bottom: 30px; }
    .item h3 { margin: 0 0 5px 0; font-size: 1.1em; color: #222; }
    .subtitle { margin: 0; font-weight: bold; color: #444; }
    .date { font-style: italic; color: #777; font-size: 0.9em; margin-bottom: 10px; }
    .item ul { margin-left: 20px; margin-bottom: 10px; }
    
    .cert-link, .sem-link { display: inline-block; margin-top: 5px; color: #0056b3; text-decoration: none; font-size: 0.9em; }
    .cert-link:hover, .sem-link:hover { text-decoration: underline; color: #003d82; }
    
    .menu-container { margin-bottom: 10px; }
    .submenu { display: none; list-style-type: none; padding-left: 15px; margin-top: 5px; }
    .submenu.open { display: block; }
    .dropdown-toggle { cursor: pointer; user-select: none; color: #0056b3; font-size: 0.9em; }
    .dropdown-toggle:hover { text-decoration: underline; }
    
    .tag-list { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 6px; }
    .tag-list span { font-size: 12.5px; background: #e8f0fe; color: #1a73e8; padding: 3px 10px; border-radius: 3px; border: 1px solid #c5d8f5; }
    
    @media (max-width: 768px) {
        .container { flex-direction: column; }
        .sidebar { width: 100%; height: auto; position: relative; border-right: none; border-bottom: 1px solid #e0e0e0; }
        .content { margin-left: 0; padding: 30px 20px; }
    }
    ]]></b:skin>
